# Never commit real secrets. Configure these in local .env or hosting provider settings.
# DATABASE_URL must be a server-side secret; do not expose it with the VITE_ prefix.
DATABASE_URL=
AUTH_SECRET=

# Leave blank until a trusted HR API has been deployed and security-tested.
# Example: https://api.example.com
VITE_HR_API_BASE_URL=
# Never put database URLs, passwords, private keys, or service tokens in VITE_* variables.
